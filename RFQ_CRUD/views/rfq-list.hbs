<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="mb-0">Requests for quotation</h1>
    <a class="btn btn-primary" href="/contractor/rfqs/new">Create RFQ</a>
</div>

<div class="surface overflow-hidden">
    {{#if rfqs}}
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th scope="col">RFQ number</th><th scope="col">Jobsite</th><th scope="col">Materials</th><th scope="col">Status</th></tr></thead>
            <tbody>
                {{#each rfqs}}
                <tr>
                    <th scope="row"><a href="/contractor/rfqs/{{rfq_id}}">{{rfq_number}}</a></th>
                    <td>{{#if site_name}}{{site_name}}{{else}}Unassigned{{/if}}</td>
                    <td>{{item_count}}</td>
                    <td><span class="status">{{status}}</span></td>
                </tr>
                {{/each}}
            </tbody>
        </table>
    </div>
    {{else}}
    <div class="p-4">
        <h2 class="h5">No RFQs yet</h2>
        <p class="mb-0 text-secondary">Create a draft to start your material list.</p>
    </div>
    {{/if}}
</div>
